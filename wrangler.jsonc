{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "sibmt-refer",
  "compatibility_date": "2026-08-11",

  // nodejs_compat            — Next runtime ต้องใช้ Node built-ins
  // global_fetch_strictly_public — fetch ที่ยิงหา origin ตัวเองต้องออกไปทาง
  //                            อินเทอร์เน็ตจริง ไม่ลัดวงจรภายใน worker
  //                            ถ้าไม่มี การเรียก Google Sheets API จะพฤติกรรมเพี้ยน
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }

  // ไม่ได้ตั้ง R2 incremental cache, self-reference service และ images binding
  // ตามที่ template ของ adapter ใส่มาให้ เพราะแอปนี้ไม่ได้ใช้:
  //   • ไม่มี ISR และไม่มี 'use cache' — หน้าหลังบ้านทุกหน้าเป็น force-dynamic
  //     เพราะข้อมูลเคสต้องสดเสมอ ส่วนหน้าสาธารณะ prerender ตอน build
  //   • ไม่ได้ใช้ next/image จึงไม่ต้องมี image optimization binding
  // ทุกอันที่ตัดออกต้องสร้าง resource บน Cloudflare เพิ่ม การใส่ไว้โดยไม่ได้ใช้
  // ทำให้ deploy ล้มด้วยเหตุผลที่ไม่เกี่ยวกับแอปเลย
  //
  // ⚠️ ห้ามใส่ค่าลับ (GOOGLE_PRIVATE_KEY, AUTH_SECRET, DASHBOARD_USERS,
  //    BOOKING_API_TOKEN) ลงในไฟล์นี้ — ไฟล์นี้ขึ้น git
  //    ใช้ `wrangler secret put` หรือหน้า Settings ของ Worker แทน
  //    ดู docs/DEPLOYMENT.md
}
