# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง
#
# ⚠️ ห้าม commit ไฟล์ .env.local ลง repo (.gitignore ครอบไว้แล้ว)
#    บน Cloudflare Pages ให้ตั้งค่าเหล่านี้ที่ Settings → Variables and Secrets
#    ดูขั้นตอนใน docs/DEPLOYMENT.md
#
# ถ้าไม่ตั้งค่าทั้งสามตัว dashboard จะแสดงข้อมูลตัวอย่างพร้อมป้ายแจ้งเตือน
# ทำให้เปิดสาธิตได้โดยไม่ต้องมี Google Sheet

# อีเมลของ service account ที่มีสิทธิ์ Viewer บน Google Sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# private key ของ service account — ใส่ทั้งก้อนรวม header/footer
# ขึ้นบรรทัดใหม่ให้ใช้ \n เช่น "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# ID ของ Google Sheet (ส่วนกลางของ URL ระหว่าง /d/ กับ /edit)
GOOGLE_SHEET_ID=
