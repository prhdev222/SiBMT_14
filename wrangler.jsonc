{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "sibmt-14",
  "compatibility_date": "2026-08-11",

  // nodejs_compat            — Next runtime ต้องใช้ Node built-ins
  // global_fetch_strictly_public — fetch ที่ยิงหา origin ตัวเองต้องออกไปทาง
  //                            อินเทอร์เน็ตจริง ไม่ลัดวงจรภายใน worker
  //                            ถ้าไม่มี การเรียก Google Sheets API จะพฤติกรรมเพี้ยน
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // กันเดารหัสผ่านที่หน้า /login
  //
  // ⚠️ ต้องทำตรงนี้ ไม่ใช่ที่ WAF — กฎ Rate limiting ของ WAF ผูกกับ zone
  //    (โดเมนที่อยู่ในบัญชีเรา) แต่ *.workers.dev เป็นโดเมนของ Cloudflare เอง
  //    จึงไม่มีเมนู WAF ให้ตั้ง ถ้าวันหลังผูกโดเมนของภาควิชาแล้วจะย้ายไป WAF
  //    ก็ทำได้ แต่ตัวนี้ทำงานได้เลยตั้งแต่วันนี้
  //
  // namespace_id เป็นเลขที่เราตั้งเอง ไม่ต้องไปสร้าง resource ที่ไหน
  // period ใส่ได้เฉพาะ 10 หรือ 60 วินาทีเท่านั้น
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      // กันการไล่เดารหัสอ้างอิง + เบอร์โทร เพื่อเข้าหน้าจัดการนัดของคนอื่น
      // ใจกว้างกว่าหน้า login เพราะแพทย์คนเดียวอาจเปิดดูนัดหลายเคสติดกัน
      "name": "MANAGE_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ]

  // ไม่ได้ตั้ง R2 incremental cache, self-reference service และ images binding
  // ตามที่ template ของ adapter ใส่มาให้ เพราะแอปนี้ไม่ได้ใช้:
  //   • ไม่มี ISR และไม่มี 'use cache' — หน้าหลังบ้านทุกหน้าเป็น force-dynamic
  //     เพราะข้อมูลเคสต้องสดเสมอ ส่วนหน้าสาธารณะ prerender ตอน build
  //   • ไม่ได้ใช้ next/image จึงไม่ต้องมี image optimization binding
  // ทุกอันที่ตัดออกต้องสร้าง resource บน Cloudflare เพิ่ม การใส่ไว้โดยไม่ได้ใช้
  // ทำให้ deploy ล้มด้วยเหตุผลที่ไม่เกี่ยวกับแอปเลย
  //
  // ⚠️ ห้ามใส่ค่าลับ (GOOGLE_PRIVATE_KEY, AUTH_SECRET, DASHBOARD_USERS,
  //    BOOKING_API_TOKEN) ลงในไฟล์นี้ — ไฟล์นี้ขึ้น git
  //    ใช้ `wrangler secret put` หรือหน้า Settings ของ Worker แทน
  //    ดู docs/DEPLOYMENT.md
}
