# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง
#
# ⚠️ ห้าม commit ไฟล์ .env.local ลง repo (.gitignore ครอบไว้แล้ว)
#    บน Cloudflare Worker ให้ตั้งค่าเหล่านี้ที่ Settings → Variables and Secrets
#    ดูขั้นตอนใน docs/DEPLOYMENT.md
#
# ── รหัสผ่านเข้า dashboard ────────────────────────────────────────────
# ⚠️ ไม่ตั้งสองตัวนี้ = ใครที่รู้ลิงก์เข้าดูข้อมูลได้ทั้งหมด
#    หน้าจอจะขึ้นแถบแดงเตือน แต่ยังเปิดได้ เพื่อไม่ให้การพัฒนาติดขัด
#    ก่อนเปิดใช้จริง "ต้อง" ตั้งค่าทั้งสองตัว
#
# กุญแจสำหรับเซ็น session cookie — พิมพ์อะไรยาว ๆ มั่ว ๆ ก็ได้ ไม่ต้องจำ
# เปลี่ยนค่านี้เมื่อไหร่ ทุกคนที่ล็อกอินค้างอยู่จะถูกตัดออกทันที
AUTH_SECRET=

# รายชื่อผู้ใช้ — รูปแบบ ชื่อ:รหัสผ่าน คั่นแต่ละคนด้วย ;
#
# แบบง่าย พิมพ์รหัสผ่านลงไปตรง ๆ ได้เลย:
#   DASHBOARD_USERS=admin:ยาวหน่อยนะรหัสนี้;fellow1:อีกรหัสหนึ่งที่ยาวพอ
#
# ข้อควรระวังเมื่อพิมพ์ตรง ๆ
#   - ห้ามใช้รหัสที่ซ้ำกับบริการอื่น (อีเมล ธนาคาร โรงพยาบาล)
#     เพราะถ้าไฟล์นี้หลุด รหัสนั้นหลุดไปด้วยทันที
#   - ยาว 12 ตัวอักษรขึ้นไป เป็นวลี 3-4 คำจำง่ายกว่าและเดายากกว่า
#   - ห้ามมี ; ในรหัสผ่าน (ใช้เป็นตัวคั่น) ส่วน : ใช้ได้ปกติ
#
# แบบเก็บเป็น hash (ไม่บังคับ) — รหัสตัวจริงจะไม่อยู่ในไฟล์นี้เลย
#   node scripts/make-user.mjs somchai      → ได้บรรทัดที่คัดลอกมาวางแทน
#   ผสมกับแบบพิมพ์ตรง ๆ ในค่าเดียวกันได้ ระบบดูออกเอง
DASHBOARD_USERS=

# ── ฐานข้อมูลแยกสำหรับการจองกลุ่มที่ 1 เท่านั้น ────────────────────────
# ใช้ Turso/libSQL ตอนนี้ และเปลี่ยนเป็น URL ของ libSQL ที่ติดตั้งเองได้ภายหลัง
# กลุ่มที่ 1 ใช้ Turso/libSQL เท่านั้น
GROUP1_DATABASE_URL=
GROUP1_DATABASE_AUTH_TOKEN=

# ── LINE OA ถามคิวนัดสำหรับ Fellow (ไม่มี Push แจ้งเตือน) ───────────────
# ตั้ง Webhook URL ใน LINE Developers เป็น:
#   https://<โดเมนของคุณ>/api/line/webhook
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# รูปแบบ: ชื่อ Fellow::รหัสลงทะเบียน;อีกชื่อ::อีกรหัส
# รหัสนี้ใช้ครั้งเดียวตอนผูกบัญชี LINE กับ Fellow
GROUP1_LINE_FELLOW_CODES=
# ถ้าต้องการใช้รหัสเดียวกันทุก Fellow ให้ใส่ค่านี้แทน (ความปลอดภัยต่ำกว่า)
GROUP1_LINE_SHARED_CODE=

# บน Cloudflare ให้ตั้งทุกค่าข้างบนเป็น Secret:
# AUTH_SECRET, DASHBOARD_USERS,
# GROUP1_DATABASE_URL, GROUP1_DATABASE_AUTH_TOKEN,
# LINE_CHANNEL_SECRET, LINE_CHANNEL_ACCESS_TOKEN,
# และ GROUP1_LINE_SHARED_CODE หรือ GROUP1_LINE_FELLOW_CODES อย่างใดอย่างหนึ่ง
